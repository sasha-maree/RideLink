# RideLink Environment Variables Example
# Do not place real secrets in this file. Copy to .env for local development.

JWT_SECRET=change-me-in-local-environment-use-a-secure-random-string-at-least-256-bits

# Service Ports
PORT_ACCOUNT=8081
PORT_DRIVER_VEHICLE=8082
PORT_RIDE=8083
PORT_FARE_PAYMENT=8084

# MongoDB Configuration
MONGODB_URI_ACCOUNT=mongodb://localhost:27017/ridelink_account
MONGODB_URI_DRIVER_VEHICLE=mongodb://localhost:27017/ridelink_driver_vehicle
MONGODB_URI_RIDE=mongodb://localhost:27017/ridelink_ride
MONGODB_URI_FARE_PAYMENT=mongodb://localhost:27017/ridelink_fare_payment

# Service URLs
ACCOUNT_SERVICE_URL=http://localhost:8081
DRIVER_VEHICLE_SERVICE_URL=http://localhost:8082
RIDE_SERVICE_URL=http://localhost:8083
FARE_PAYMENT_SERVICE_URL=http://localhost:8084
